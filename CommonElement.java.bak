class CommonElement 
{
	public static void main(String[] args) 
	{
		int nums1[] = {1,5,10,20,40,80,100};
		int nums2[] = {6,7,20,80,100,200,300,400};
		int nums3[] = {3,4,15,20,30,70,80,120};
		
		int i=0, j=0, k=0; 
		while(i<nums1.length && j<nums2.length && k<nums3.length)
		{
			if(nums1[i] == nums2[j] && nums2[j] == nums3[k])
			{
				System.out.println(nums1[i]);
				i++;
				j++;
				k++;
			}
			else if(nums1[i] < nums2[j] &&  nums1[i] < nums3[k])
			{
				i++;
			}
			else if(nums2[j]< nums3[k])
			{
				j++;
			}
			else
			{
				k++;
			}
		}
	}
}
