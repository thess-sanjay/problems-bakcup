import java.util.Arrays;

class lRotationKtimes 
{
	public static void main(String[] args) 
	{
		int nums[] = {10,20,30,40,50};
		int k = 1;
		int n = nums.length;
		
		for(int i=0; i<k; i++)
		{
			int start = nums[0];
			
			for(int j=1; j<=n-1; j++)
			{
				nums[j-1] = nums[j];
			}
			nums[n-1] = start;
		}
		
		System.out.println(Arrays.toString(nums));
	}
}
