import java.util.Scanner;


class Fibonnacci 
{
	static Scanner scan = new Scanner(System.in);
	public static void main(String[] args) 
	{
		int n =scan.nextInt();
		int a = 0;
		int b = 1;
		
		System.out.print(a + " " + b + " ");
		
		for(int i=2; i<9; i++)
		{
			int c = a+b;
			System.out.print(c + " ");
			a=b;
			b=c;
		}
	} 
}
