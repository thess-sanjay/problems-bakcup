import java.util.*;

class LeftRotation
{
	public static void main(String[] args)
	{
		int nums[] = {10, 20, 30, 40, 50};
		int start = nums[0];
		int n = nums.length;
		
		for(int i=1; i<=n-1; i++)
		{
			nums[i - 1] = nums[i];
		}
		nums[n-1] = start;
		
		System.out.println(nums);
	}
}