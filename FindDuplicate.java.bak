import java.util.*;

class FindDuplicate 
{
	public static void main(String[] args) 
	{
		int arr[] = {2,10,5,3,1,5,2,12};
		int n = arr.length;
		for(int i=0; i<n; i++)
		{
			for(int j=i+1; j<n; j++)
			{
				if(arr[i] == arr[j])
				{
					System.out.println(arr[j]);
				}
			}
		}
		
	}
}
